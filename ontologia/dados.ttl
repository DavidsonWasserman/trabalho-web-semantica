    acad:email "joao.pereira@example.ufrrj.br" ;
    foaf:mbox <mailto:joao.pereira@example.ufrrj.br> ;
    acad:apresentacao "Sou estudante de Sistemas de Informação e tenho interesse em desenvolvimento de aplicações web, tecnologias para organização e compartilhamento de dados e inteligência artificial. Durante a graduação, venho buscando oportunidades para relacionar os conhecimentos das disciplinas a projetos práticos, trabalhos em grupo e atividades acadêmicas. Tenho experiência introdutória com programação e bancos de dados e pretendo aprofundar minha formação em engenharia de software e ciência de dados." ;
    acad:paginaPessoal "https://davidsonwasserman.github.io/trabalho-web-semantica/exemplos/perfis/joao-pereira.html"^^xsd:anyURI ;
