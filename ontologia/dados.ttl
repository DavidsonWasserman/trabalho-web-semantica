recurso:DocenteAnaSilva a owl:NamedIndividual , acad:Docente , acad:Pessoa ;
    acad:nome "Profa. Dra. Ana Exemplo da Silva" ;
    foaf:name "Profa. Dra. Ana Exemplo da Silva" ;
    acad:cargoOuFuncao "Professora Associada" ;
    acad:email "ana.silva@example.ufrrj.br" ;
    foaf:mbox <mailto:ana.silva@example.ufrrj.br> ;
    acad:apresentacao "Sou professora da área de Computação, com formação em Sistemas de Informação, mestrado em Informática e doutorado em Ciência da Computação. Minha trajetória acadêmica inclui atividades de ensino, pesquisa e orientação de estudantes em temas relacionados à Web Semântica, à Engenharia de Conhecimento e aos Dados Abertos. Tenho experiência em projetos de modelagem e integração de dados, desenvolvimento de aplicações e representação de conhecimento. Atualmente, meus interesses de trabalho envolvem a publicação e o interligamento de dados acadêmicos, a construção de soluções baseadas em conhecimento e o uso de tecnologias da Web para ampliar o acesso à informação científica." ;
    acad:paginaPessoal "https://davidsonwasserman.github.io/trabalho-web-semantica/exemplos/perfis/ana-silva.html"^^xsd:anyURI ;
    foaf:homepage <https://davidsonwasserman.github.io/trabalho-web-semantica/exemplos/perfis/ana-silva.html> ;
    acad:orcid "https://orcid.org/0000-0002-1825-0097"^^xsd:anyURI ;
    acad:lattes "http://lattes.cnpq.br/1234567890123456"^^xsd:anyURI ;
    rdfs:seeAlso <https://orcid.org/0000-0002-1825-0097> , <http://lattes.cnpq.br/1234567890123456> ;
    acad:vinculadoAUnidade recurso:ICEx ;
    acad:lotadoEm recurso:DeptoComputacao ;
    acad:atuaEmArea recurso:AreaWebSemantica , recurso:AreaEngenhariaConhecimento , recurso:AreaDadosAbertos ;
    acad:leciona recurso:DiscWebSemantica , recurso:DiscBancoDados , recurso:DiscEngSoftware ;
    acad:temInteresseEm recurso:AreaWebSemantica , recurso:AreaEngenhariaConhecimento , recurso:AreaDadosAbertos , recurso:AreaLinkedOpenData ;
    acad:participaDeProjeto recurso:ProjDadosAbertosUFRRJ ;
    acad:membroDeGrupo recurso:GrupoSistemasInteligentes , recurso:GrupoDadosWeb ;
